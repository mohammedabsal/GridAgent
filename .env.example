# GridAgent-AI Environment Configuration
# Copy this file to .env and customize as needed

# Application Settings
APP_NAME=GridAgent-AI
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Database (SQLite for local prototype)
DATABASE_URL=sqlite:///./gridagent.db

# Data Provider Mode: "SIMULATION" or "LIVE_API"
# Note: Prototype defaults to SIMULATION. Do not misrepresent simulation data as live grid telemetry.
GRID_DATA_PROVIDER=SIMULATION

# Cloud Execution Runtime Mode: "SIMULATED_K8S", "KUBERNETES_API", "AWS_BATCH", "GCP_CLOUD_RUN"
CLOUD_RUNTIME_PROVIDER=SIMULATED_K8S

# AI / Gemini / Antigravity Configuration
# Optional: Provide a Gemini API key to enable live LLM reasoning alongside the deterministic optimizer.
# When empty, GridAgent-AI uses its deterministic + explainable hybrid reasoning engine.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.0-flash
USE_ANTIGRAVITY_SDK=false

# Optional External Grid API Keys (for future LIVE_API integration)
ELECTRICITY_MAPS_API_KEY=""
ELECTRICITY_MAPS_ZONE=IN-WE
WATTTIME_USERNAME=
WATTTIME_PASSWORD=

# Safety & Governance Thresholds
SAFETY_COST_LIMIT_USD=500.0
SAFETY_ENERGY_LIMIT_KWH=500.0
SAFETY_MIN_DEADLINE_SLACK_MINUTES=15
